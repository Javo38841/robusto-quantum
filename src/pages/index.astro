---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CorridorMap from '../components/CorridorMap.astro';
import AxisCards from '../components/AxisCards.astro';
import { Image } from 'astro:assets';
import heroPhoto from '../assets/puerto-iquique.jpg';
import demosPhoto from '../assets/tren-salar-carcote.jpg';
import { company, program, team, lmsStats, memberVars } from '../data/site';
import { guideSteps, guidePdf } from '../data/guia';

// Fotos con licencia libre (hero y demos): el crédito es obligatorio (CC BY-SA 4.0).
const demosCredit = {
  title: 'Ferrocarril en el salar de Carcote',
  author: 'Diego Delso',
  source: 'https://commons.wikimedia.org/wiki/File:Ferrocarril_en_el_salar_de_Carcote,_Chile,_2016-02-09,_DD_70.JPG',
  license: 'CC BY-SA 4.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0/deed.es',
};
const photoCredit = {
  title: 'Puerto de Iquique',
  author: 'Corsario CL',
  source: 'https://commons.wikimedia.org/wiki/File:Puerto_de_Iquique.jpg',
  license: 'CC BY-SA 4.0',
  licenseUrl: 'https://creativecommons.org/licenses/by-sa/4.0/deed.es',
};

// Las secciones siguen los criterios de evaluación de la Vía B de Quantum III:
// motivación (25%), equipo y capacidad transferible (35%), potencial de adaptación (25%)
// y diferenciación (15%).

// Cifras del Plan de Acción de la Comisión de Alto Nivel del CBV, citadas en las bases de Quantum III.
const gaps = [
  { value: '26', label: 'brechas prioritarias identificadas para la región' },
  { value: '46%', label: 'corresponden a eficiencia operacional' },
  { value: '38%', label: 'a riesgos de sostenibilidad del sistema logístico' },
];

// Motivación del equipo: la misma idea que la respuesta B6 del formulario de postulación.
// Si cambia una, actualizar la otra.
const motivation = [
  'Tarapacá será la salida al Pacífico del Corredor Bioceánico. Pero el diagnóstico de la región muestra baja digitalización y trazabilidad, y las soluciones tecnológicas para el corredor han venido mayoritariamente de fuera.',
  'Lo vemos de cerca: trabajamos en la región y sabemos que buena parte de la operación todavía se coordina con planillas, papeles y llamadas. Queremos que la tecnología para operar el corredor se construya aquí, desde Tarapacá.',
  'Por eso postulamos por la Vía B: para aplicar lo que ya sabemos hacer al desafío logístico real que se nos asigne en el Challenge Discovery, y trabajarlo durante todo el programa.',
];

// Lo que esperamos tener al terminar el programa (respuesta B6).
const goals = [
  'Un desafío logístico real, validado con sus usuarios.',
  'Un MVP probado con una empresa o actor del corredor.',
  'Un modelo de negocio claro.',
  'La red de contactos para convertir ese piloto en un producto replicable para otros operadores.',
];

const t = lmsStats.tests;
const totalTests = t.unit + t.integration + t.e2e;
const counters = [
  { value: totalTests, label: 'pruebas automáticas' },
  { value: lmsStats.prsMerged, label: 'cambios revisados e integrados' },
  { value: lmsStats.environments, label: 'ambientes en paralelo' },
  { value: lmsStats.adrs, label: 'decisiones de arquitectura documentadas' },
];

// Experiencia real del equipo (criterio "capacidad transferible"). A propósito no se
// nombran las empresas donde trabajamos. `by` son las iniciales de quien la aporta.
const capabilities: { by: string[]; kind: string; title: string; text: string }[] = [
  {
    by: ['JC'],
    kind: 'En producción',
    title: 'Gestión de flota en una importadora de ZOFRI',
    text: 'Un MVP que ubica los vehículos en un mapa y registra cada llave por gaveta numerada. Hoy lo usan bodega, jefatura de logística y el área comercial.',
  },
  {
    by: ['JC'],
    kind: 'En producción',
    title: 'Integración de sistemas empresariales',
    text: 'Una API que conecta el ERP con el CRM de un proveedor externo para consultar notas de venta y emitir facturas, más análisis de fallas del ERP hasta su origen.',
  },
  {
    by: ['TS'],
    kind: 'En producción',
    title: 'Migración de plataformas críticas a escala',
    text: 'Diseño de arquitecturas backend y migración de plataformas que usan cerca de un millón de personas.',
  },
  {
    by: ['SM'],
    kind: 'En producción',
    title: 'Datos en tiempo real, siempre disponibles',
    text: 'Integración de datos en tiempo real (GTFS-RT) para paneles de transporte público, sobre servicios Linux tolerantes a fallos.',
  },
  {
    by: ['JC', 'TS', 'SM'],
    kind: 'Proyecto conjunto',
    title: 'Plataforma multi-organización desde cero',
    text: 'Un LMS con los datos de cada organización aislados, pruebas automáticas en tres capas y despliegue automático en dos ambientes.',
  },
];

const byInitials = (initials: string) => team.find((m) => m.initials === initials)!;
const firstName = (initials: string) => byInitials(initials).name.split(' ')[0];

const hasGuide = guidePdf.ready;
const guideHref = hasGuide
  ? `/${guidePdf.file}`
  : `mailto:${company.email}?subject=${encodeURIComponent(`Quiero la guía de ${company.name}`)}`;

// Íconos de línea (24×24, trazo en currentColor) para la sección "Qué nos diferencia".
const icons = {
  // Marcador de mapa
  pin: '<path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>',
  // Escudo con check
  shield: '<path d="M12 3 4.5 6v5.5c0 4.6 3.2 8.3 7.5 9.5 4.3-1.2 7.5-4.9 7.5-9.5V6L12 3z"/><path d="m8.8 12 2.2 2.2 4.2-4.4"/>',
  // Capas apiladas
  layers: '<path d="M12 3 3 7.5 12 12l9-4.5L12 3z"/><path d="m3 12 9 4.5 9-4.5"/><path d="m3 16.5 9 4.5 9-4.5"/>',
  // Nube sobre un servidor
  cloud: '<path d="M7 10.5a3.25 3.25 0 1 1 .8-6.4A4.75 4.75 0 0 1 17 5.3a2.6 2.6 0 0 1 .2 5.2z"/><path d="M12 10.5V14"/><rect x="4" y="14" width="16" height="6.5" rx="1.5"/><path d="M7.5 17.25h.01M11 17.25h5.5"/>',
};

const differences = [
  { icon: icons.pin, title: 'Equipo de la región', text: 'Vamos a terreno y volvemos con cambios cada semana.' },
  { icon: icons.shield, title: 'Rigor de equipo grande', text: 'ISO/IEC 29110, pruebas automáticas y cada cambio revisado.' },
  { icon: icons.layers, title: 'Una plataforma, muchas empresas', text: 'Cada operador con sus datos aislados y sus permisos.' },
  { icon: icons.cloud, title: 'En la nube o en tus servidores', text: 'Corre donde lo exija tu operación.' },
];
---

<BaseLayout
  title={`${company.name} · ${company.tagline}`}
  description={`Equipo de ingenieros de Tarapacá, ${program.status.toLowerCase()} a ${program.name}, que aplica su experiencia en software a desafíos logísticos del Corredor Bioceánico.`}
>
  <!-- HERO -->
  <section id="inicio" class="hero">
    <Image
      class="hero-photo"
      src={heroPhoto}
      alt=""
      width={2000}
      widths={[800, 1400, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="kicker mono">{program.status} a {program.short} · {program.via}</p>
        <h1>{company.tagline}.</h1>
        <p class="hero-lead">
          Somos un equipo de ingenieros de Tarapacá que ya construye software exigente en otros sectores. Queremos aplicar esa
          capacidad a desafíos reales de la logística regional, junto a las empresas del corredor.
        </p>
        <div class="hero-ctas">
          <a class="btn btn-primary" href="#capacidad">Ver lo que ya hacemos</a>
          <a class="btn ghost" href="#demos">Probar las demos</a>
        </div>
      </div>
      <CorridorMap />
    </div>
    <p class="photo-credit">
      Foto: <a href={photoCredit.source} rel="noopener">«{photoCredit.title}»</a>, {photoCredit.author} ·
      <a href={photoCredit.licenseUrl} rel="noopener">{photoCredit.license}</a> · vía Wikimedia Commons
    </p>
  </section>

  <!-- MOTIVACIÓN -->
  <section id="motivacion" class="section">
    <div class="container">
      <SectionHeader kicker="Por qué logística, por qué desde aquí" title="El corredor llega a Iquique. Queremos que su tecnología también se haga aquí." />
      <div class="motivation">
        <div class="motivation-copy">
          {motivation.map((p) => <p>{p}</p>)}
          <h3 class="goals-title">Al terminar el programa esperamos tener</h3>
          <ol class="goals">
            {goals.map((g) => <li>{g}</li>)}
          </ol>
        </div>
        <div class="gaps">
          {
            gaps.map((g) => (
              <div class="card gap">
                <span class="gap-value">{g.value}</span>
                <span class="gap-label">{g.label}</span>
              </div>
            ))
          }
        </div>
      </div>
      <p class="source mono">Fuente: Plan de Acción de la Comisión de Alto Nivel del Corredor Bioceánico Vial, citado en las bases de {program.short}.</p>
    </div>
  </section>

  <!-- CAPACIDAD TRANSFERIBLE -->
  <section id="capacidad" class="section alt">
    <div class="container">
      <SectionHeader kicker="Lo que ya sabemos hacer" title="Software que ya usan personas reales, todos los días.">
        <p class="lead">
          Somos tres ingenieros de software: uno desarrolla soluciones logísticas en una importadora de ZOFRI, otro lidera
          desarrollo en una empresa de software y el tercero lleva sistemas de alta disponibilidad a producción. No llegamos
          con una idea en blanco.
        </p>
      </SectionHeader>
      <div class="lines">
        {
          capabilities.map((c) => (
            <article
              class:list={['card', 'line', 'by', { joint: c.by.length > 1 }]}
              style={c.by.length === 1 ? memberVars(byInitials(c.by[0]).color) : undefined}
            >
              <div class="who">
                <span class="dots" aria-hidden="true">
                  {c.by.map((i) => {
                    const m = byInitials(i);
                    return m.photo ? (
                      <Image class="dot photo" style={memberVars(m.color)} src={m.photo} alt="" width={60} height={60} />
                    ) : (
                      <span class="dot mono" style={memberVars(m.color)}>
                        {i}
                      </span>
                    );
                  })}
                </span>
                <span class="who-text">
                  {c.by.length === 1 ? `${firstName(c.by[0])} · ${c.kind.toLowerCase()}` : c.kind}
                </span>
              </div>
              <h3>{c.title}</h3>
              <p class="cap-text">{c.text}</p>
            </article>
          ))
        }
      </div>

      <h3 class="subhead spaced">El LMS, en números</h3>
      <div class="counters">
        {
          counters.map((c) => (
            <div class="card counter">
              <span class="counter-value mono">{c.value}</span>
              <span class="counter-label">{c.label}</span>
            </div>
          ))
        }
      </div>
      <p class="source mono">Conteo en el repositorio al {lmsStats.countedAt}.</p>
      <a class="btn btn-primary more" href="/por-dentro">Abre por dentro la plataforma que llevaremos al desafío →</a>
    </div>
  </section>

  <!-- DEMOS -->
  <section id="demos" class="section photo-section">
    <Image class="section-photo" src={demosPhoto} alt="" width={2000} widths={[800, 1400, 2000]} sizes="100vw" quality={55} />
    <div class="container">
      <SectionHeader kicker="Pruebas de concepto" title="Dos demos que puedes probar ahora.">
        <p class="lead">
          Funcionan en tu navegador, con datos ficticios. Son para conversar sobre un problema con algo concreto en pantalla.
        </p>
      </SectionHeader>
      <AxisCards />
    </div>
    <p class="photo-credit">
      Foto: <a href={demosCredit.source} rel="noopener">«{demosCredit.title}»</a>, {demosCredit.author} ·
      <a href={demosCredit.licenseUrl} rel="noopener">{demosCredit.license}</a> · vía Wikimedia Commons
    </p>
  </section>

  <!-- CÓMO TRABAJAR CON NOSOTROS (guía para clientes) -->
  <section id="guia" class="section alt">
    <div class="container">
      <SectionHeader kicker="Cómo trabajar con nosotros" title="Qué haces tú en cada paso. Sin tecnicismos.">
        <p class="lead">
          No necesitas saber de software. Son cinco pasos, y en cada uno recibes algo concreto.
        </p>
      </SectionHeader>
      <ol class="gflow" aria-label="Pasos para trabajar con nosotros">
        {
          guideSteps.map((g, i) => (
            <li>
              <span class="gdot mono" aria-hidden="true">{i + 1}</span>
              <h3>{g.title}</h3>
              <p><span class="mono">Recibes</span>{g.get}</p>
            </li>
          ))
        }
      </ol>

      <div class="card guide-cta">
        <div class="guide-cover" aria-hidden="true">
          <span class="mono">Guía</span>
          <strong>Cómo trabajar con {company.name}</strong>
          <small>Paso a paso, para tu equipo</small>
        </div>
        <div class="guide-cta-copy">
          <h3>Llévate la guía completa</h3>
          <p>
            Qué haces tú en cada paso, quién de tu equipo participa y cuánto tiempo toma. Incluye un checklist para la
            primera reunión, respuestas a las preguntas de siempre y nuestro contacto.
          </p>
          <a class="btn btn-primary" href={guideHref} download={hasGuide ? '' : undefined}>
            {hasGuide ? 'Descargar la guía (PDF)' : 'Pídenos la guía por correo'}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- DIFERENCIACIÓN -->
  <section id="diferencia" class="section">
    <div class="container">
      <SectionHeader kicker="Qué nos diferencia" title="Cerca de la operación, con el rigor de un equipo profesional." />
      <div class="guarantees">
        {
          differences.map((d) => (
            <div class="guarantee">
              <span class="g-icon" aria-hidden="true">
                <svg
                  viewBox="0 0 24 24"
                  width="32"
                  height="32"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={d.icon}
                />
              </span>
              <h4>{d.title}</h4>
              <p>{d.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    program.videoUrl && (
      <section id="video" class="section">
        <div class="container">
          <SectionHeader kicker="En 3 minutos" title="Quiénes somos y por qué queremos trabajar en logística." />
          <div class="video">
            <iframe src={program.videoUrl} title={`Video de presentación de ${company.name}`} loading="lazy" allowfullscreen />
          </div>
        </div>
      </section>
    )
  }

  <!-- EQUIPO -->
  <section id="equipo" class="section alt">
    <div class="container">
      <SectionHeader kicker="Equipo" title="Formados en la UTFSM. Construyendo para Tarapacá." />
      <div class="team">
        {
          team.map((m) =>
            m.pending ? (
              <a class="card member pending join" href="/unete">
                <span class="avatar" aria-hidden="true">{m.initials}</span>
                <div class="join-text">
                  <h3>Tu lugar aquí</h3>
                  <p class="role">Tarapacá</p>
                  <p class="bio">{m.bio}</p>
                </div>
                <span class="go">¿Quieres sumarte? Únete al equipo →</span>
              </a>
            ) : (
              <article class="card member" style={memberVars(m.color)}>
                {m.photo ? (
                  <Image class="avatar photo" src={m.photo} alt={m.name} width={112} height={112} />
                ) : (
                  <span class="avatar" aria-hidden="true">{m.initials}</span>
                )}
                <div>
                  <h3>{m.name}</h3>
                  <p class="role">{m.role}</p>
                </div>
                <p class="bio">{m.bio}</p>
                {m.skills.length > 0 && <ul class="chips">{m.skills.map((s) => <li>{s}</li>)}</ul>}
                {m.github && (
                  <a class="gh mono" href={m.github} rel="noopener">
                    {m.github.replace('https://', '')}
                  </a>
                )}
                {m.linkedin && (
                  <a class="gh mono in" href={m.linkedin} rel="noopener">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                      <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z" />
                    </svg>
                    {m.linkedin.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '')}
                  </a>
                )}
              </article>
            ),
          )
        }
      </div>
    </div>
  </section>

  <!-- CONTACTO -->
  <section id="contacto" class="contact">
    <div class="container contact-inner">
      <div>
        <h2>¿Tu empresa tiene un desafío logístico que hoy vive en papel o planillas?</h2>
        <p>Buscamos desafíos reales para trabajar con quienes operan el corredor. Conversemos sin compromiso.</p>
      </div>
      <a class="btn btn-primary" href={`mailto:${company.email}?subject=${encodeURIComponent(`Desafío para ${company.name}`)}`}>
        Escríbenos
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO: foto del puerto de fondo, con una capa del color del hero para que el texto
     y el mapa del corredor se lean igual que antes. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--hero-bg);
    color: var(--hero-ink);
    padding: 72px 0 88px;
  }
  .hero-photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, var(--hero-bg) 0%, color-mix(in srgb, var(--hero-bg) 88%, transparent) 45%, color-mix(in srgb, var(--hero-bg) 62%, transparent) 100%),
      linear-gradient(0deg, var(--hero-bg) 0%, transparent 35%);
  }
  /* Sección con foto de fondo (demos): mismo método que el hero. Redefine los colores
     para que el texto y las tarjetas se lean sobre la capa oscura. */
  .photo-section {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--hero-bg);
    color: var(--hero-ink);
    --ink: var(--hero-ink);
    --ink-2: var(--hero-ink-2);
    --muted: #9fb0bd;
    --accent: #3cc2b8;
    --sand: #e0a54a;
    --line: rgb(255 255 255 / 0.16);
    --surface: color-mix(in srgb, var(--hero-bg) 74%, transparent);
  }
  .section-photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }
  .photo-section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--hero-bg) 92%, transparent) 0%, color-mix(in srgb, var(--hero-bg) 70%, transparent) 55%, color-mix(in srgb, var(--hero-bg) 88%, transparent) 100%);
  }
  .photo-section :global(.card) {
    backdrop-filter: blur(6px);
  }
  .photo-credit {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 10px;
    text-align: right;
    margin: 0;
    font-size: 11px;
    color: var(--hero-ink-2);
    opacity: 0.8;
  }
  .photo-credit a {
    color: inherit;
  }
  .hero-grid {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .hero h1 {
    font-size: clamp(34px, 5.5vw, 56px);
  }
  .hero-lead {
    font-size: 19px;
    color: var(--hero-ink-2);
    max-width: 56ch;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .ghost {
    color: var(--hero-ink);
    border-color: rgb(255 255 255 / 0.35);
  }

  /* OPORTUNIDAD */
  .gaps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 16px;
  }
  .gap {
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .gap-value {
    font-size: 44px;
    font-weight: 800;
    color: var(--sand);
    line-height: 1.1;
  }
  .gap-label {
    color: var(--ink-2);
  }
  .source {
    margin-top: 14px;
    font-size: 12px;
    color: var(--muted);
  }

  /* QUÉ HACEMOS */
  .lines {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }
  .line {
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  /* Colores por integrante: cada tarjeta toma --m (ver memberVars en src/data/site.ts). */
  .line.by {
    border-top: 4px solid var(--m);
  }
  .line.joint {
    border-top: 0;
    background-image: linear-gradient(90deg, var(--m-amber) 33.3%, var(--m-violet) 33.3% 66.6%, var(--m-blue) 66.6%);
    background-size: 100% 4px;
    background-repeat: no-repeat;
  }
  .who {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .dots {
    display: flex;
  }
  .dot {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 600;
    background: var(--m);
