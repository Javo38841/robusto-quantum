  .who {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    padding-top: 2px;
  }
  /* Persona en ámbar y agente en turquesa: los mismos colores marcan lo que cada agente
     puede (turquesa). Lo que no puede va en rojo y "Las personas deciden" en verde, para que
     el límite y la decisión humana resalten. --m-amber pasa contraste AA como texto. */
  .human .who {
    color: var(--m-amber);
  }
  .ai .who {
    color: var(--accent);
  }
  @media (min-width: 900px) {
    .flow {
      grid-template-columns: repeat(6, 1fr);
