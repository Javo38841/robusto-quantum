  .name {
    font-weight: 600;
    font-size: 16px;
    color: var(--ink);
    margin-bottom: 2px;
  }
  .can,
  .cannot {
    font-size: 15px;
  }
  .can {
    color: var(--accent);
  }
  .cannot {
    color: var(--bad);
  }
  .decide {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 6px 14px;
    padding: 18px 20px;
    border: 1.5px solid var(--ok);
    border-radius: 10px;
    background: color-mix(in srgb, var(--ok) 12%, transparent);
    font-size: 18px;
    text-align: center;
