    .flow li {
      padding: 54px 10px 0;
      align-items: center;
      text-align: center;
    }
    .flow li::before,
    .flow li:first-child::before,
    .flow li:last-child::before {
      left: 0;
      right: 0;
      top: 18px;
      bottom: auto;
      width: auto;
      height: 2px;
    }
    .flow li:first-child::before {
      left: 50%;
    }
    .flow li:last-child::before {
      right: 50%;
    }
    .dot {
      left: calc(50% - 19px);
    }
  }
  .agents {
    padding: clamp(16px, 3vw, 28px);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .agent-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr));
    gap: 16px;
  }
  .agent {
