---
interface Props {
  kicker: string;
  title: string;
}
const { kicker, title } = Astro.props;
---

<div class="header">
  <p class="kicker mono">{kicker}</p>
  <h2>{title}</h2>
  <slot />
</div>

<style>
  .header {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 40px;
  }
  .kicker {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h2 {
    font-size: clamp(28px, 4vw, 40px);
    max-width: 24ch;
  }
</style>
