---
import { axes } from '../data/demos';
---

<ul class="axes">
  {
    axes.map((a) => (
      <li>
        {a.ready ? (
          <a class="card axis" href={`/demos/${a.slug}`}>
            <span class="n mono">{a.n}</span>
            <span class="axis-name">{a.axis}</span>
            <h3>{a.demo}</h3>
            <p>{a.summary}</p>
            <span class="go">Probar la demo →</span>
          </a>
        ) : (
          <div class="card axis soon">
            <span class="n mono">{a.n}</span>
            <span class="axis-name">{a.axis}</span>
            <h3>{a.demo}</h3>
            <p>{a.summary}</p>
            <span class="go">Próximamente</span>
          </div>
        )}
      </li>
    ))
  }
</ul>

<style>
  .axes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 20px;
  }
  li {
    display: flex;
  }
  .axis {
    flex: 1;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.15s,
      transform 0.15s;
  }
  a.axis:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .n {
    font-size: 13px;
    font-weight: 600;
    color: var(--sand);
  }
  .axis-name {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  h3 {
    font-size: 20px;
  }
  p {
    color: var(--ink-2);
    font-size: 15px;
  }
  .go {
    margin-top: auto;
    padding-top: 8px;
    font-weight: 600;
    color: var(--accent);
  }
  .soon {
    border-style: dashed;
    opacity: 0.75;
  }
  .soon .go {
    color: var(--muted);
  }
</style>
