---
// Adaptado del portafolio: las estaciones del CI real del LMS, contadas para alguien
// que no es desarrollador. "Simular fallo" muestra que un error no llega a producción.
const stations = [
  { name: 'Review', detail: 'Otra persona del equipo revisa cada cambio antes de aceptarlo. Nadie aprueba su propio trabajo.' },
  { name: 'Styles', detail: 'Reglas automáticas de estilo y formato: el código se lee igual sin importar quién lo escribió.' },
  { name: 'Types', detail: 'El compilador verifica que los datos calcen en todo el sistema antes de ejecutarlo.' },
  { name: 'Units', detail: 'Pruebas de cada pieza por separado: cálculos, permisos y validaciones.' },
  { name: 'Integration', detail: 'La API completa contra una base de datos real, con las mismas migraciones que producción.' },
  { name: 'E2E', detail: 'Un navegador automático usa el sistema como lo haría una persona, de inicio a fin.' },
];
const failAt = 3;
---

<div class="card pipeline" data-pipeline data-fail-at={failAt} data-details={JSON.stringify(stations.map((s) => s.detail))}>
  <div class="controls">
    <button type="button" class="btn btn-primary" data-run>▶ Enviar un cambio</button>
    <button type="button" class="btn" data-fail>Simular un error</button>
  </div>

  <ol class="stations">
    {
      stations.map((s, i) => (
        <li>
          <button type="button" class="station" data-station={i} aria-pressed="false">
            <span class="dot" aria-hidden="true" />
            {s.name}
          </button>
        </li>
      ))
    }
  </ol>

  <p class="detail" data-detail aria-live="polite">Toca una etapa para ver qué revisa.</p>

  <div class="targets" data-targets>
    <div class="target">
      <div class="mono env-label">Ambiente de prueba</div>
      <div class="env">Donde validas cada viernes</div>
    </div>
    <div class="target">
      <div class="mono env-label">Producción</div>
      <div class="env">Solo lo que aceptaste</div>
    </div>
  </div>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-pipeline]').forEach((root) => {
    const stations = [...root.querySelectorAll<HTMLButtonElement>('[data-station]')];
    const detail = root.querySelector<HTMLElement>('[data-detail]')!;
    const details: string[] = JSON.parse(root.dataset.details ?? '[]');
    const targets = root.querySelector<HTMLElement>('[data-targets]')!;
    const failAt = Number(root.dataset.failAt);
    let timers: number[] = [];

    const run = (fail: boolean) => {
      timers.forEach(clearTimeout);
      timers = [];
      stations.forEach((s) => (s.dataset.state = ''));
      targets.dataset.state = '';
      const last = fail ? failAt : stations.length - 1;
      const step = reduce ? 0 : 320;
      for (let i = 0; i <= last; i++) {
        timers.push(
          window.setTimeout(() => {
            const failed = fail && i === failAt;
            stations[i].dataset.state = failed ? 'fail' : 'ok';
            if (failed) {
              targets.dataset.state = 'blocked';
              detail.textContent = 'Una prueba falló: el cambio queda detenido y no llega a ningún ambiente hasta corregirlo.';
            } else if (i === last) {
              targets.dataset.state = 'ok';
              detail.textContent = 'Todo en verde: el cambio se despliega solo al ambiente de prueba para que lo valides.';
            }
          }, step * (i + 1)),
        );
      }
    };

    root.querySelector('[data-run]')!.addEventListener('click', () => run(false));
    root.querySelector('[data-fail]')!.addEventListener('click', () => run(true));
    stations.forEach((s, i) =>
      s.addEventListener('click', () => {
        stations.forEach((o) => o.setAttribute('aria-pressed', String(o === s)));
        detail.textContent = `${s.textContent?.trim()}: ${details[i]}`;
      }),
    );
  });
</script>

<style>
  .pipeline {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .stations {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 8px;
  }
  .station {
    width: 100%;
    min-height: 64px;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    color: var(--ink);
    font: 600 14px var(--font-sans);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    cursor: pointer;
  }
  .station:hover,
  .station[aria-pressed='true'] {
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line);
    transition: background 0.2s;
  }
  .station[data-state='ok'] .dot {
    background: var(--ok);
  }
  .station[data-state='fail'] {
    border-color: var(--bad);
  }
  .station[data-state='fail'] .dot {
    background: var(--bad);
  }
  .detail {
    min-height: 3.2em;
    font-size: 15px;
    color: var(--ink-2);
  }
  .targets {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: 12px;
    transition: opacity 0.2s;
  }
  .targets[data-state='blocked'] {
    opacity: 0.35;
  }
  .target {
    border: 1.5px dashed var(--accent);
    border-radius: 10px;
    padding: 14px 16px;
  }
  .targets[data-state='ok'] .target {
    border-style: solid;
    background: var(--accent-soft);
  }
  .env-label {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent);
  }
  .env {
    font-weight: 600;
  }
</style>
